{
  "info": {
    "name": "API de Gerenciamento de Pedidos",
    "description": "Rode com o servidor recem-iniciado (npm start) e envie na ordem: a API guarda os pedidos em memoria e a requisicao 05 depende do pedido 1 criado pela 01.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - POST valido (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 201', () => pm.response.to.have.status(201));",
              "pm.test('pedido nasce como recebido', () => pm.expect(pm.response.json().status).to.eql('recebido'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"Carlos Silva\",\n  \"tipo\": \"entrega\",\n  \"valor\": 350,\n  \"prioridade\": \"normal\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:3000/pedidos",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["pedidos"]
        }
      }
    },
    {
      "name": "02 - POST invalido (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 400', () => pm.response.to.have.status(400));",
              "pm.test('explica os erros em JSON', () => pm.expect(pm.response.json().detalhes).to.have.lengthOf(3));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"   \",\n  \"tipo\": \"drone\",\n  \"valor\": -5,\n  \"prioridade\": \"normal\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:3000/pedidos",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["pedidos"]
        }
      }
    },
    {
      "name": "03 - GET lista de pedidos (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 200', () => pm.response.to.have.status(200));",
              "pm.test('retorna uma lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/pedidos",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["pedidos"]
        }
      }
    },
    {
      "name": "04 - GET id inexistente (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 404', () => pm.response.to.have.status(404));",
              "pm.test('explica o erro em JSON', () => pm.expect(pm.response.json().erro).to.eql('Pedido 999 não encontrado.'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/pedidos/999",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["pedidos", "999"]
        }
      }
    },
    {
      "name": "05 - PATCH status valido (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 200', () => pm.response.to.have.status(200));",
              "pm.test('status foi atualizado', () => pm.expect(pm.response.json().status).to.eql('em_preparacao'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
