        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"em_preparacao\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:3000/pedidos/1/status",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["pedidos", "1", "status"]
        }
      }
    },
